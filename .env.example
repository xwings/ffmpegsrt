# Copy to .env and fill in your own values. .env is gitignored — never commit it.
#
# Any OpenAI-compatible chat/completions endpoint works. The base URL should
# include the version path, e.g. https://api.openai.com/v1

FFMPEGSRT_API_BASE=https://your-endpoint.example.com/v1
FFMPEGSRT_API_KEY=sk-your-key-here
FFMPEGSRT_MODEL=your-model-name
